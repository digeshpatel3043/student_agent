# Copy this file to ".env" (same folder as agent.py) and put your own Groq key in it.
# Never share or commit the real key.
GROQ_API_KEY=your-groq-api-key-here

# Model name. If you get "model not available", run:  python agent.py --models
MODEL=llama-3.3-70b-versatile

# Optional. "Today" for the demo data (fee due dates are relative to this). Keep as is for the sample data.
AS_OF_DATE=2026-10-28
